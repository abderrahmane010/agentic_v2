# Dataiku DSS Configuration
DSS_HOST=https://your-dss-instance.com:10000
DSS_API_KEY=your-api-key-here
# true only for a self-signed certificate (disables TLS verification)
DSS_INSECURE_TLS=false

# Security
# true = block every tool that modifies DSS (recommended while exploring)
DSS_READ_ONLY=true
# Comma-separated list of allowed project keys (empty = all projects)
DSS_ALLOWED_PROJECTS=

# Default project of scripts/classer_datasets.py and scripts/smoke_test.py
DSS_PROJECT_KEY=
