# Dataiku DSS Configuration
DSS_HOST=https://your-dss-instance.com:10000
DSS_API_KEY=your-api-key-here
# true only for a self-signed certificate (disables TLS verification)
DSS_INSECURE_TLS=false

# Security
# true = block every tool that modifies DSS (recommended while exploring)
DSS_READ_ONLY=true
# Comma-separated list of allowed project keys (empty = all projects)
DSS_ALLOWED_PROJECTS=

# Default project of scripts/classer_datasets.py and scripts/smoke_test.py
DSS_PROJECT_KEY=

# LLM (OpenAI-compatible API, e.g. vLLM) used by scripts/chat_llm.py
VLLM_BASE_URL=https://your-vllm-host/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
OPENAI_API_KEY=EMPTY
VLLM_INSECURE_TLS=false
# Path to the company CA certificate (PEM) if TLS verification fails
VLLM_CA_BUNDLE=
# true = the chat only exposes read-only tools to the LLM
CHAT_READ_ONLY=true
# Max characters of a tool result sent to the LLM
CHAT_MAX_RESULT_CHARS=40000
